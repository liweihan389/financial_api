# Run python3 scripts/configure.py to create .env with a random access token.
FINANCIAL_API_TOKEN=
FINANCIAL_IMAGE=ghcr.io/liweihan389/financial_api:0.3.1
FINANCIAL_BIND_ADDRESS=127.0.0.1
FINANCIAL_PORT=8765
FINANCIAL_PUBLIC_URL=http://127.0.0.1:8765
FINANCIAL_ALLOW_FULL_IMPORT=1
# Optional SEC application name and contact email. Blank disables online SEC jobs.
SEC_USER_AGENT=
